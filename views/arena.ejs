<%- include('partials/header', { title: 'Digital Auction Arena' }) %>

<section id="arena" class="section arena-wrap">
  <!-- Cinematic intro overlay -->
  <div id="arenaIntro" class="arena-intro" aria-live="polite">
    <div class="intro-scan"></div>
    <div class="intro-inner">
      <div class="intro-line">System Access Granted</div>
      <div class="intro-sub">Decrypting Auction Matrix…</div>
    </div>
  </div>

  <div class="container">
    <h2 class="neon">Arena of Algorithms</h2>
    <p class="tagline">Click a hologram to enter a team zone.</p>
  </div>

  <!-- 3D arena scene -->
  <div class="arena-scene" id="arenaScene">
    <div class="arena-camera" id="arenaCamera">
      <div class="arena-grid" id="arenaGrid">
        <% teams.forEach((t,i)=> { if (t.slug === 'code-trail') return; %>
          <button class="holo-tile" data-slug="<%= t.slug %>" data-name="<%= t.name %>" data-tag="<%= t.tagline %>" data-img="/images/teams/<%= t.slug %>.jpg" data-coord="<%= i %>">
            <span class="tile-img" aria-hidden="true" style="background-image:url('/images/teams/<%= t.slug %>.jpg')"></span>
            <span class="tile-scan" aria-hidden="true"></span>
            <span class="tile-name"><%= t.name %></span>
          </button>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Team details panel -->
  <div id="arenaPanel" class="arena-panel" hidden>
    <div class="panel-inner">
      <h3 id="panelName" class="neon"></h3>
      <img id="panelImg" alt="Team emblem" style="max-width:260px;border:1px solid #3b2466;border-radius:12px;margin:8px 0"/>
      <p id="panelTag" class="tagline"></p>
      <div class="actions">
        <a class="btn" id="panelBid" href="/auction">Place a Bid</a>
        <button class="btn" id="panelClose" type="button">Back to Arena</button>
      </div>
    </div>
  </div>
  
  <!-- Memory / Code Guessing Challenge -->
  <section id="arenaChallenge" class="section arena-challenge">
    <div class="container">
      <h3 class="neon">Memory Challenge: Reconstruct the Code</h3>
      <p class="tagline">Memorize the holographic code, then type it. Correct answers energize your core; mistakes drain it.</p>

      <div class="energy-wrap">
        <div class="energy-head">
          <span>Energy</span>
          <span class="energy-num"><span id="energyVal">50</span>/100</span>
        </div>
        <div class="energy-bar bar" id="energyBar"><span style="width:50%"></span></div>
      </div>

      <div class="challenge-ui">
        <div class="code-area">
          <code id="codeDisplay" aria-live="polite"></code>
        </div>
        <div class="actions">
          <button class="btn" id="startRound" type="button">Start Round</button>
          <input id="codeInput" type="text" inputmode="latin" autocomplete="off" placeholder="Type the code…" aria-label="Enter the code" />
          <button class="btn" id="codeSubmit" type="button">Submit</button>
        </div>
        <div id="challengeStatus" class="status" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <!-- Logic Rush: Quick Logic Quiz Battle -->
  <section id="logicRush" class="section logic-rush">
    <div class="container">
      <h3 class="neon">Logic Rush — Quick Logic Quiz Battle</h3>
      <p class="tagline">5-second brain bursts. Choose fast. Win faster. Leaderboard updates live.</p>

      <div class="lr-wrap">
        <div class="lr-left">
          <div class="timer-ring" title="Countdown">
            <div class="ring" id="lrRing"></div>
            <div class="ring-num" id="lrTime">5</div>
          </div>
          <div class="lr-question" id="lrQuestion">Waiting for next question…</div>
          <div class="lr-options" id="lrOptions" role="group" aria-label="Logic Rush options"></div>
          <div id="lrFeedback" class="lr-feedback" aria-live="polite"></div>
        </div>
        <div class="lr-right">
          <h4 class="neon" style="margin:0 0 8px">Leaderboard</h4>
          <ol class="lr-board" id="lrBoard" aria-live="polite"></ol>
        </div>
      </div>
    </div>
  </section>
</section>

<%- include('partials/footer') %>
